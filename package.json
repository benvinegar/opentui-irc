{
  "name": "openirc",
  "version": "0.0.0",
  "private": true,
  "description": "A newcomer-friendly IRC client built with OpenTUI, SolidJS, and Bun",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "bun run src/main.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:bun": "bun run scripts/test-bun.ts",
    "test:ergo": "bun run scripts/smoke-ergo.ts",
    "test:terminal": "python3 scripts/smoke-terminal.py",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run test:bun",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@opentui/core": "0.6.6",
    "@opentui/solid": "0.6.6",
    "jsonc-parser": "^3.3.1",
    "solid-js": "1.9.12"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "simple-git-hooks": {
    "pre-commit": "bun run format:check && bun run lint"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "packageManager": "bun@1.3.14"
}
